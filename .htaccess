# ===== Impulso Estratégico CX & AI · Hostinger (.htaccess) · web nueva (Astro) =====
# Ojo: public_html también tiene api/ (formulario), contenido/ y .git/ del sitio anterior. No borrarlos al subir.

ErrorDocument 404 /404.html
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www -> dominio principal en un solo salto
  RewriteCond %{HTTP_HOST} ^www\.impulsoestrategicocx\.com$ [NC]
  RewriteRule ^ https://impulsoestrategicocx.com%{REQUEST_URI} [L,R=301]

  # Forzar HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Direcciones del sitio anterior (ago-2026) -> nuevas (301, conserva UTM)
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^servicios\.html$ /soluciones/ [R=301,L]
  RewriteRule ^casos\.html$ /casos/ [R=301,L]
  RewriteRule ^ia-energia-solar\.html$ /soluciones/vigila-oportunidades/ [R=301,L]
  RewriteRule ^automatizacion-ventas-b2b\.html$ /soluciones/vende-mas/ [R=301,L]
  RewriteRule ^software-comercio-ecommerce\.html$ /soluciones/deja-el-excel/ [R=301,L]
  RewriteRule ^automatizacion-head-hunting\.html$ /soluciones/deja-el-excel/ [R=301,L]
  RewriteRule ^software-agroindustria\.html$ /soluciones/deja-el-excel/ [R=301,L]
  RewriteRule ^caso-licitaciones-energia-solar\.html$ /casos/licitaciones-energia-solar/ [R=301,L]
  RewriteRule ^caso-prospeccion-b2b\.html$ /casos/prospeccion-b2b/ [R=301,L]
  RewriteRule ^caso-crm-ecommerce-comercio\.html$ /casos/crm-ecommerce-comercio/ [R=301,L]
  RewriteRule ^caso-automatizacion-head-hunting\.html$ /casos/automatizacion-head-hunting/ [R=301,L]
  RewriteRule ^caso-crm-erp-agroindustria\.html$ /casos/app-ganadera/ [R=301,L]
  RewriteRule ^casos/crm-erp-agroindustria/?$ /casos/app-ganadera/ [R=301,L]
  RewriteRule ^contacto\.html$ /radiografia/ [R=301,L]
  RewriteRule ^blog\.html$ /aprende/ [R=301,L]
  RewriteRule ^blog-crm-a-medida-cuando-conviene\.html$ /aprende/crm-a-medida-cuando-conviene/ [R=301,L]
  RewriteRule ^nosotros\.html$ /nosotros/ [R=301,L]
  RewriteRule ^privacidad\.html$ /privacidad/ [R=301,L]
  RewriteRule ^terminos\.html$ /terminos/ [R=301,L]
  RewriteRule ^sitemap\.xml$ /sitemap-index.xml [R=301,L]

  # Bloquear archivos internos (documentos, git, configuración)
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(md|mjs|ts|json|lock|log|sh|py|env|yml|yaml)$ - [F,L]
  RewriteRule ^contenido(/|$) - [F,L]
  RewriteRule ^api/config(\.example)?\.php$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"

  # Caché: archivos con huella (_astro/) un año; imágenes 30 días; HTML siempre fresco
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

AddDefaultCharset UTF-8
AddType text/html;charset=UTF-8 .html
AddType image/webp .webp
AddType font/woff2 .woff2
