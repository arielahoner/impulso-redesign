# ===== Impulso Estratégico CX & AI · Hostinger (.htaccess) =====

# Página de error 404 personalizada
ErrorDocument 404 /404.html

# Forzar HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ===== Cabeceras de seguridad =====
<IfModule mod_headers.c>
  # Fuerza HTTPS durante 1 año en navegadores (incluye subdominios).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Evita que el sitio se incruste en iframes de terceros (clickjacking).
  Header always set X-Frame-Options "DENY"

  # Impide que el navegador "adivine" el tipo de archivo (MIME sniffing).
  Header always set X-Content-Type-Options "nosniff"

  # Controla cuánta info de referencia se envía a otros sitios.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Desactiva APIs sensibles del navegador que el sitio no usa.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

  # Content-Security-Policy: lista blanca de orígenes permitidos.
  # script-src incluye el hash del único script inline (el del tema claro/oscuro
  # en el <head>). Si modificas ese script, regenera el hash o la página no cargará.
  # googletagmanager / google-analytics están permitidos para GA4.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-pju4LYfnNkuP8J+7/y9gvjSWf8x+o5xIoFhcZeNdMjQ=' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"

  # No cachear el HTML (para que cambios de contenido se vean al instante).
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ===== Compresión =====
# Brotli (más eficiente) cuando el servidor lo soporta.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
# GZIP como respaldo universal.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# ===== Cache de estáticos =====
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# Protege archivos sensibles.
<FilesMatch "^\.(htaccess|htpasswd|env|gitignore)$">
  Require all denied
</FilesMatch>

# La configuración del formulario (contiene la API key de Resend) nunca se sirve.
<FilesMatch "^config(\.example)?\.php$">
  Require all denied
</FilesMatch>

# Documentación interna y scripts: viven en el repositorio, no se sirven por web.
<FilesMatch "\.(md|sh)$">
  Require all denied
</FilesMatch>
